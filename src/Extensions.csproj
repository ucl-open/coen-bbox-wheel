<Project Sdk="Microsoft.NET.Sdk">

  <!-- No sources: the box has no C# of its own. Kept because lib-open-rigs' check-workflow.ps1 builds it and loads its
       Extensions.dll, YamlDotNet.dll and Newtonsoft.Json.dll from the build output. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- Bonsai compiles src\Extensions itself with the .NET Framework's csc, which is C# 5. -->
    <LangVersion>5</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>